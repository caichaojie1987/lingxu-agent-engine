# ── 引擎 ─────────────────────────────────────────────
AGENT_ENGINE_PORT=8020
# 容器/远程部署改 0.0.0.0（默认只听 127.0.0.1）
AGENT_ENGINE_HOST=127.0.0.1
# 业务后端地址（工具执行走它的内部只读 API；demo 场景不需要）
AGENT_BACKEND_URL=http://127.0.0.1:8010
# 与业务后端共享的服务令牌（/chat 门禁；自己生成一串随机值）
AGENT_SERVICE_TOKEN=change-me-to-a-long-random-string

# ── 模型 ─────────────────────────────────────────────
# provider/model。模型 Key 配在 pi 的 provider 配置里（见 README「配置模型」）
AGENT_MODEL=deepseek/deepseek-v4-flash
AGENT_MAX_SESSIONS=32
AGENT_LLM_ATTEMPTS=3
# 备用模型（provider/model，空=不降级）
AGENT_LLM_FALLBACK_MODEL=

# ── 合规 ─────────────────────────────────────────────
# 出口词库（不设则用仓内 demo 词库）
# COMPLIANCE_LEXICON_PATH=./config/compliance_lexicon.demo.json
